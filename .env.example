# Salin ke .env. Semua opsional; service inti jalan tanpa konfigurasi apa pun.

# Bearer token untuk HTTP API. Kalau diisi, setiap request harus kirim
# `Authorization: Bearer <key>`.
WATERMARKS_SERVER_API_KEY=

# Dipakai skill / curl (bukan compose). Default http://127.0.0.1:8765.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# Mode hook PostToolUse: check (lapor saja) atau clean (bersihkan di tempat).
# WATERMARKS_HOOK_MODE=check

# Layer B rewrite lewat rewrite_text.py (opsional; skill melakukan Layer B
# sendiri dengan model-nya dan tidak butuh ini).
# WATERMARKS_REWRITE_BACKEND=ollama
# WATERMARKS_REWRITE_MODEL=llama3.2
# WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434
