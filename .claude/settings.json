{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/service/scripts/hook_written_file.py\" --mode check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
